# GeoLibre Storymaps — single .env for frontend + backend
#
# Load with:  set -a; source .env; set +a   (then start the server)
# Vite reads this file automatically for the frontend (VITE_* only).
#
# Copy to .env and fill in your values. Never commit the real .env.

# ── Backend (Go server) ────────────────────────────────────────────────
# REQUIRED — JWT signing secret (any long random string)
JWT_SECRET=dev-secret

# HTTP listen port (default 8080)
APP_PORT=8080

# URL prefix the app is served under (e.g. "/maps" for storyboard.ink/maps).
# Empty = root. Must match VITE_BASE_PATH. The server strips this prefix from
# every request and prefixes media/OAuth redirect URLs with it.
# BASE_PATH=/maps

# Data / media directories (defaults derive from DATA_DIR)
DATA_DIR=./data
# DB_PATH=./data/sqlite.db
# MEDIA_DIR=./data/media

# Admin local-login user (seeded idempotently; optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Max upload size in bytes (default 25 MB)
# MEDIA_MAX_BYTES=26214400

# Comma-separated allow-list of external media hosts (empty = permissive)
# ALLOWED_MEDIA_HOSTS=example.com,media.example.org

# Upload store: "local" (default) or "s3"
# STORE_KIND=local

# When 1, stories set to public go to status=pending (moderation)
# MODERATION_REQUIRED=0

# ── GitHub SSO (backend) ───────────────────────────────────────────────
# From your GitHub OAuth App (Settings → Developer settings → OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Usually leave these at their defaults
# GITHUB_OAUTH_BASE=https://github.com/login/oauth
# GITHUB_API_BASE=https://api.github.com

# Where the browser is redirected after login.
# ⚠ MUST match your real frontend origin. Default is :5173, but this app
#   runs on :5174 (5173 is occupied by another project).
FRONTEND_ORIGIN=http://localhost:5174

# ── Frontend (Vite) ───────────────────────────────────────────────────
# API base URL. Default "/api" = same origin (dev proxy → :8080).
# Set to a full origin in production, e.g. https://api.example.com
VITE_API=/api

# URL prefix the app is served under (e.g. "/maps"). Must match BASE_PATH.
# Empty = root. Used to build API/media/OAuth URLs and the Vite build base.
# VITE_BASE_PATH=/maps
