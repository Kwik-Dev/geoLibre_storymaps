# GeoLibre Storymaps — production env (loaded by systemd via EnvironmentFile)
# Copy to /opt/storymaps/.env on the VPS and fill in real values.
# Never commit the real .env.

# REQUIRED — long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Port the Go server listens on (Caddy proxies to this)
APP_PORT=8081

# Persistent data dir (SQLite + media). Must be writable by the service user.
DATA_DIR=/opt/storymaps/data

# Admin local-login user (seeded idempotently)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# GitHub OAuth (SSO) — from your GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MUST match your real domain (and the Caddyfile + GitHub callback URL)
FRONTEND_ORIGIN=https://yourdomain.com

# URL prefix the app is served under (e.g. "/maps" when WordPress owns the
# root). Empty = root. Must match VITE_BASE_PATH. The server strips this prefix
# from every request and appends it to the GitHub OAuth redirect/callback URLs.
BASE_PATH=/maps

# Optional
# MEDIA_MAX_BYTES=26214400
# ALLOWED_MEDIA_HOSTS=example.com,media.example.org
# MODERATION_REQUIRED=0
