# GeoLibre Storymaps + WordPress — Caddy reverse proxy
#
# storyboard.ink runs WordPress (Apache) at the root and GeoLibre Storymaps
# under /maps (the Go server). Caddy terminates HTTPS and routes:
#
#   /maps/*  → Go server on 127.0.0.1:8081   (GeoLibre Storymaps)
#   /*       → Apache on 127.0.0.1:8080      (WordPress)
#
# IMPORTANT: the Go server strips the /maps prefix itself (BASE_PATH=/maps),
# so Caddy must forward the FULL path — do NOT strip it here.
#
# The GitHub OAuth App's callback URL must be:
#   https://storyboard.ink/maps/api/auth/github/callback
# (it already includes the base path because the server appends BASE_PATH to
#  FRONTEND_ORIGIN when building the redirect).

storyboard.ink {
    # GeoLibre Storymaps — forward the full /maps path to the Go server.
    handle /maps/* {
        reverse_proxy 127.0.0.1:8081
    }

    # Everything else → WordPress (Apache on 127.0.0.1:8080).
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}
