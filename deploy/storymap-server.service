# GeoLibre Storymaps — systemd unit for the Go server
#
# Install to /etc/systemd/system/storymap-server.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now storymap-server
#
# Layout on the VPS:
#   /opt/storymaps/server/storymap-server   (the Go binary)
#   /opt/storymaps/dist/index.html          (the built frontend)
#   /opt/storymaps/data/                    (SQLite + uploaded media)
#   /opt/storymaps/.env                     (env vars, see .env.example)

[Unit]
Description=GeoLibre Storymaps server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storymaps
Group=storymaps
# The server serves ../dist relative to its cwd, so run it from /opt/storymaps/server.
WorkingDirectory=/opt/storymaps/server
EnvironmentFile=/opt/storymaps/.env
ExecStart=/opt/storymaps/server/storymap-server
Restart=always
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
